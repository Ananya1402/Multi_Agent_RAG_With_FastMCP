# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Weather Configuration (Open-Meteo – free, no API key needed)
WEATHER_DEFAULT_CITY=London

# FastMCP Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=faq_collection

# FAQ Data Path
FAQ_CSV_PATH=../data/faqs.csv

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql://multi_agent_rag:multi_agent_rag@localhost:5432/multi_agent_rag
